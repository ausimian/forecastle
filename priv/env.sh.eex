
# --- Forecastle: Castle integration (generated, do not edit) ---
#
# Before the system boots, expand the build-time configuration in build.config
# into sys.config by running this release's config providers in a short-lived
# preboot VM, and ensure releases/RELEASES exists so that the OTP
# release_handler can manage this release.
case $RELEASE_COMMAND in
  start|start_iex|daemon|daemon_iex|eval)
    CASTLE_VSN_DIR="$RELEASE_ROOT/releases/$RELEASE_VSN"

    # The launcher sources this file before it assigns the release variables,
    # so runtime.exs would see them unset. Apply the launcher's own defaults
    # here, ahead of expanding the configuration that may read them. Each is
    # the same "use the caller's value if there is one" form the launcher uses,
    # so the assignments it makes after this file has been sourced see values
    # already present and leave them alone.
    RELEASE_COOKIE="${RELEASE_COOKIE:-"$(cat "$RELEASE_ROOT/releases/COOKIE")"}"
    export RELEASE_COOKIE
    RELEASE_MODE="${RELEASE_MODE:-"embedded"}"
    export RELEASE_MODE
    RELEASE_NODE="${RELEASE_NODE:-"$RELEASE_NAME"}"
    export RELEASE_NODE
    RELEASE_TMP="${RELEASE_TMP:-"$RELEASE_ROOT/tmp"}"
    export RELEASE_TMP
    RELEASE_VM_ARGS="${RELEASE_VM_ARGS:-"$CASTLE_VSN_DIR/vm.args"}"
    export RELEASE_VM_ARGS
    RELEASE_REMOTE_VM_ARGS="${RELEASE_REMOTE_VM_ARGS:-"$CASTLE_VSN_DIR/remote.vm.args"}"
    export RELEASE_REMOTE_VM_ARGS
    RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-"sname"}"
    export RELEASE_DISTRIBUTION
    RELEASE_BOOT_SCRIPT="${RELEASE_BOOT_SCRIPT:-"start"}"
    export RELEASE_BOOT_SCRIPT
    RELEASE_BOOT_SCRIPT_CLEAN="${RELEASE_BOOT_SCRIPT_CLEAN:-"start_clean"}"
    export RELEASE_BOOT_SCRIPT_CLEAN

    # Run from wherever the launcher was invoked, so that a relative
    # RELEASE_VM_ARGS, and any relative path the configuration itself reads,
    # resolve the way they do for every other command. Only make_releases/0
    # needs the release root, and it changes directory for itself.
    #
    # The version and the root reach Elixir through the environment rather than
    # being interpolated into the expression, so neither a release root
    # containing brackets nor an unexpected RELEASE_VSN can alter it.
    "$CASTLE_VSN_DIR/elixir" \
         --erl-config "$CASTLE_VSN_DIR/build" \
         --boot "$CASTLE_VSN_DIR/preboot" \
         --boot-var RELEASE_LIB "$RELEASE_ROOT/lib" \
         --vm-args "$RELEASE_VM_ARGS" \
         --eval "Castle.generate(System.fetch_env!(~s(RELEASE_VSN)));
                 File.cd!(System.fetch_env!(~s(RELEASE_ROOT)), &Castle.make_releases/0)" || {
      echo "ERROR: Cannot start release because $CASTLE_VSN_DIR/sys.config could not be generated" >&2
      exit 1
    }

    unset CASTLE_VSN_DIR
    ;;

  *)
    ;;
esac
# --- Forecastle: end Castle integration ---
