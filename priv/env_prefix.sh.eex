# --- Forecastle: CASTLE_ENV_FILE (generated, do not edit) ---
#
# Sources the file the supervisor names in CASTLE_ENV_FILE, over the environment
# the launcher was started with, so that a restart configures this version from
# it. A Castle that supports the file (castle#56) sources it in exactly this way
# when a hot install or a commit resolves this version's configuration, and that
# is what makes a hot install and a restart agree. Change the two together or
# not at all.
#
# Every command, not only the ones that start the system: `eval` runs
# runtime.exs too, and a file that sets RELEASE_COOKIE or RELEASE_NODE has to
# reach `rpc`, `remote` and `stop`, or they cannot find the node. The consequence
# is that a broken file stops those as well, `bin/castle` included.
#
# A prefix, ahead of the project's own env.sh, so that it can use what the file
# sets. Unset or empty, nothing happens.
#
# A relative name is joined to this version's own directory under the release
# root, $RELEASE_ROOT/releases/$RELEASE_VSN, where this env.sh is - so each
# version reads its own file, and a rollback reads the file the version it
# returns to was installed with. An absolute name is one file for every
# version. Either way the path `.` is given has a slash in it: given a bare
# name, `.` searches PATH rather than the directory.
# The readability check is explicit so that the message is the same under every
# shell, and so that Castle can refuse an install with the same words.
#
# A start that re-execs into a provisional version reads the replaced
# version's file and then the provisional version's over it, and Castle's peer
# reads the target's over the running node's environment. So a variable an
# earlier file set survives unless this one unsets it, and the file must be
# idempotent: assignments and `unset`, never `PATH=$PATH:...`. Nothing guards
# against a second read, because a guard would be state exported across the
# re-exec.
if [ -n "${CASTLE_ENV_FILE-}" ]; then
  case $CASTLE_ENV_FILE in
    /*) castle_env_file=$CASTLE_ENV_FILE ;;
    *)  castle_env_file=$RELEASE_ROOT/releases/$RELEASE_VSN/$CASTLE_ENV_FILE ;;
  esac
  if ! [ -f "$castle_env_file" ] || ! [ -r "$castle_env_file" ]; then
    printf '%s\n' "ERROR: CASTLE_ENV_FILE names $castle_env_file, which is not a readable file" >&2
    exit 1
  fi
  set -a
  . "$castle_env_file"
  set +a
  unset castle_env_file
fi

# --- Forecastle: end CASTLE_ENV_FILE ---

